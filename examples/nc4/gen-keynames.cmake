# Generate a key code -> name table from linux/input.h (and input-event-codes.h
# on newer kernels):
#
#   cmake -DINPUT_HEADERS="a.h;b.h" -DOUTPUT=keynames.h -P gen-keynames.cmake

set(names "")
set(seen "")
foreach(header ${INPUT_HEADERS})
  file(STRINGS ${header} lines REGEX "^#define[ \t]+(KEY|BTN)_[A-Z0-9_]+[ \t]+(0x[0-9a-fA-F]+|[0-9]+)")
  foreach(line ${lines})
    string(REGEX MATCH "^#define[ \t]+((KEY|BTN)_[A-Z0-9_]+)[ \t]+(0x[0-9a-fA-F]+|[0-9]+)" _ "${line}")
    set(name ${CMAKE_MATCH_1})
    set(value ${CMAKE_MATCH_3})
    math(EXPR code "${value}")
    # KEY_MAX, KEY_CNT and the like are not keys
    if(name MATCHES "_(MAX|CNT|RESERVED)$" OR name MATCHES "^BTN_(MISC|MOUSE|JOYSTICK|GAMEPAD|DIGI|WHEEL|TRIGGER_HAPPY)$")
      continue()
    endif()
    # keep the first name of aliased codes
    list(FIND seen ${code} found)
    if(found EQUAL -1)
      list(APPEND seen ${code})
      string(APPEND names "    {${code}, \"${name}\"},\n")
    endif()
  endforeach()
endforeach()

file(WRITE ${OUTPUT}.tmp "/* generated by gen-keynames.cmake */\n#pragma once\n\n"
  "static const struct {\n    unsigned int code;\n    const char *name;\n} key_names[] = {\n${names}};\n")
configure_file(${OUTPUT}.tmp ${OUTPUT} COPYONLY)
file(REMOVE ${OUTPUT}.tmp)
